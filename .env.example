# ============================================================================
# TIMECRAFT — KONFIGURASI ENVIRONMENT VARIABLE (.env.example)
# ============================================================================
# Cara penggunaan:
# 1. Duplikat file ini dan beri nama ".env" di folder utama proyek.
# 2. Isi nilai di bawah ini menggunakan Project URL dan Anon Public Key
#    dari dashboard proyek Supabase Anda (Settings -> API).
#
# PERINGATAN KEAMANAN:
# - JANGAN PERNAH memasukkan "service_role" secret key atau password database
#   ke dalam file .env frontend ini!
# - Semua variabel berawalan VITE_ akan terekspos ke browser pengguna.
# - Keamanan data dijamin menggunakan Row Level Security (RLS) di Supabase.
# ============================================================================

VITE_SUPABASE_URL=https://nama-proyek-anda.supabase.co
VITE_SUPABASE_ANON_KEY=isi-dengan-anon-public-key-supabase-anda
